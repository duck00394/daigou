# 資料庫連線字串（本機 PostgreSQL 或 Neon 等任何標準 PostgreSQL）
DATABASE_URL="postgresql://使用者:密碼@localhost:5432/daigou"

# 管理者密碼的 bcrypt 雜湊值（不是密碼本身）
# 產生方式：npm run hash-password -- "你的密碼"
# 在 .env 檔中，雜湊值裡的每個 $ 前面都要加反斜線（指令會直接印出正確格式）
ADMIN_PASSWORD_HASH="\$2b\$12\$請換成產生出來的雜湊值"

# 僅在本機以 http（非 https）執行 production 模式測試時設為 1；正式環境不要設定
# INSECURE_COOKIE=1
